# 💻 Complete Example

```python
# Comprehension: filter and transform data
scores = [55, 92, 78, 40, 88]
passing = [s for s in scores if s >= 60]
print("Passing scores:", passing)

# Packing/unpacking
top, *rest = sorted(passing, reverse=True)
print("Top score:", top, "| Others:", rest)

# *args and **kwargs
def summarize(label, *values, **details):
    print(f"{label}: {values}")
    for key, value in details.items():
        print(f"  {key}: {value}")

summarize("Scores", *passing, source="Term 1", subject="Math")

# Lambda with sorted
sorted_scores = sorted(passing, key=lambda s: -s)
print("Sorted (desc):", sorted_scores)

# Generator for memory-efficient processing
def grade_stream(score_list):
    for s in score_list:
        yield "A" if s >= 90 else "B" if s >= 75 else "C"

for grade in grade_stream(passing):
    print("Grade:", grade)
```

